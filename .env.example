# Alpaca API
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Which tape prices every backtest, baseline and leaderboard curve.
# Default "sip" (the full consolidated tape). "iex" is ~2.5% of volume and is a
# poor benchmark for multi-name/DJIA windows -- but it is the only feed a Basic
# plan may query inside the recent window, so a SIP refusal retries on IEX and
# the result is stamped into the run's metadata (market_data_feed /
# sip_fallback_to_iex) rather than silently ranked as if it were SIP. Curves
# priced off different feeds are not comparable: after CHANGING this value,
# force-refresh the leaderboard so cached rows are recomputed on one tape.
# An unrecognised value is fatal, never a silent fall back to the default.
# ALPACA_DATA_FEED=sip
#
# Basic plans may query SIP history only once `end` is at least 15 minutes old
# (https://docs.alpaca.markets/docs/market-data-faq), so a request whose end
# reaches into that window is clamped back to now-15m. Raise only with care:
# Alpaca filters bars on their opening timestamp, so the default keeps the
# whole 15:00-16:00 ET closing bar, but a delay above ~65 minutes drops it and
# the daily board caches that shortened curve for the rest of the session.
# ALPACA_SIP_DELAY_MINUTES=15
#
# Set on a PAID data plan to skip the clamp entirely (1/true/yes/on).
# ALPACA_ALLOW_RECENT_SIP=false

# LLM APIs (optional, for agent trading)
OPENAI_API_KEY=your_openai_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here
DEEPSEEK_API_KEY=your_deepseek_key_here

# Hosted AI Hedge Fund runtime. Install the pinned upstream package into the
# isolated venv with:
#   python -m venv .ai-hedge-fund-venv
#   .ai-hedge-fund-venv/bin/pip install -r requirements-ai-hedge-fund.txt
# Docker/Render set AI_HEDGE_FUND_PYTHON automatically. OPENROUTER_API_KEY below
# is platform-managed for the upstream portfolio-manager model. Each user
# supplies their own Financial Datasets key through the agent credential-storage
# API/UI; it must not be placed in this deployment environment.
AI_HEDGE_FUND_PYTHON=.ai-hedge-fund-venv/bin/python
# Protected platform controls (defaults shown):
# AI_HEDGE_FUND_LOOKBACK_DAYS=90
# Per-decision-step budget (1..900). The backtest subprocess timeout is sized
# from this value times the run's trading days, so raising it lengthens the
# whole run's allowance rather than getting the parent to kill the child.
# AI_HEDGE_FUND_TIMEOUT_SECONDS=300

# CommonStack unified gateway (one key for OpenAI/Google/xAI/DeepSeek/Qwen/Anthropic).
# Leaderboard entries with "integration": "commonstack" route through this.
COMMONSTACK_API_KEY=your_commonstack_key_here
COMMONSTACK_BASE_URL=https://api.commonstack.ai

# Agentic FinSearch news-signals producer (bearer key, same value as the
# FinSearch backend). Required for the Home news panel and backtest
# news_sentiment to populate; leave unset and the panel shows "unavailable"
# and backtests fail closed to an empty {} slot.
FINGPT_API_KEY=your_fingpt_api_key_here
# Optional override of the FinSearch producer base URL (defaults to the live
# endpoint). Point at a local fixture/staging server for dev.
# FINSEARCH_SIGNALS_URL=http://localhost:9000
# Optional override of the FinSearch raw news-items endpoint (defaults to the
# live endpoint). Point at a local fixture/staging server for dev.
# FINSEARCH_ITEMS_URL=https://agenticfinsearch.org/api/news/items/

# OpenRouter multi-provider gateway (Anthropic Messages skin).
# Leaderboard entries with "integration": "openrouter" route through this
# (e.g. nvidia/nemotron-3-nano-30b-a3b). Opt-in only — never auto-selected.
OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api
# Reasoning: default "medium" → reasoning.max_tokens=2048 (hard thinking budget)
# so Nemotron still emits a JSON text block. Use "none" to disable; "auto" for
# raw provider default; OPENROUTER_REASONING_MAX_TOKENS (≥1024) to override.
# Raise LLM_MAX_OUTPUT_TOKENS when reasoning is on.
OPENROUTER_REASONING_EFFORT=medium
# OPENROUTER_REASONING_MAX_TOKENS=2048
# Optional attribution headers for openrouter.ai rankings:
# OPENROUTER_HTTP_REFERER=https://github.com/Open-Finance-Lab/AgenticTrading
# OPENROUTER_APP_TITLE=Agentic Trading Lab

# iFinD A-share historical market data (default OFF).
# The access token is a backend-only secret: never expose it in browser code,
# logs, run metadata, screenshots, chat, or Git. The base URL override exists
# for controlled local tests; production uses the official iFinD endpoint.
ENABLE_IFIND_ASHARE=false
IFIND_REFRESH_TOKEN=
IFIND_ACCESS_TOKEN=
IFIND_BASE_URL=https://quantapi.51ifind.com

# vn.py simulated market data (development only, default OFF).
# Set to true/1/yes/on to expose the "vn.py simulated data" option in the
# backtest Market Data selector and accept data_source=vnpy_simulation on
# /backtest/run. Requires the optional dep: pip install -r requirements-vnpy.txt
# (a request without it returns 503, not a silent fall back to Alpaca).
# Simulated bars are program-generated, not real market data, and force the LLM
# off — never enable this on a deployment whose results are read as real.
# ENABLE_VNPY_SIMULATION=false

# Discord bot
DISCORD_BOT_TOKEN=your_discord_bot_token_here
# One or more guild (server) ids to sync slash commands to (comma-separated).
DISCORD_GUILD_ID=123456789012345678,987654321098765432
# Optional channel allowlist (comma-separated). When set, the bot only responds
# to commands in these channels; plain messages in those channels also trigger chat.
# Leave unset to allow any channel (@mention or reply-to-bot for free chat).
DISCORD_CHANNEL_ID=234567890123456789
# Enable "Message Content Intent" in the Discord Developer Portal (Bot tab)
# so the bot can read plain messages in server channels.
# Base URL of the backend API the bot calls (defaults to http://localhost:8000).
ATL_API_BASE=http://localhost:8000
# Shared secret: Discord bot → GET /api/v1/discord/agents (must match on API + bot).
DISCORD_BOT_API_SECRET=generate_a_long_random_secret_here
# Discord OAuth (same Discord Application as the bot). Used by website
# "Open Discord" to link users.discord_user_id (scope=identify).
DISCORD_CLIENT_ID=your_discord_oauth_client_id
DISCORD_CLIENT_SECRET=your_discord_oauth_client_secret
DISCORD_REDIRECT_URI=http://localhost:8000/api/auth/discord/callback
# Channel/invite URL opened after a successful link (or when already linked).
DISCORD_GUILD_CHANNEL_URL=https://discord.gg/9HnQ6XDG98
# Optional: signs the short-lived OAuth state token. Defaults to DISCORD_CLIENT_SECRET.
# DISCORD_OAUTH_STATE_SECRET=another_long_random_secret
# Frontend origin for OAuth redirects and Discord result deep links.
# Production Discord worker should use the Vercel app (not the Render API):
#   PUBLIC_APP_URL=https://agentic-trading-lab.vercel.app
# Local (API also serves /app):
# PUBLIC_APP_URL=http://localhost:8000
PUBLIC_APP_URL=https://agentic-trading-lab.vercel.app

# Robinhood Agentic Trading (OAuth + MCP). Dev: localhost callback only.
ROBINHOOD_MCP_URL=https://agent.robinhood.com/mcp/trading
ROBINHOOD_REDIRECT_URI=http://localhost:8000/api/auth/robinhood/callback
# REQUIRED to link Robinhood or save hosted-agent credentials. Broker OAuth
# tokens and per-agent Financial Datasets keys are encrypted at rest with this
# key; stores refuse writes/decryption when it is unset (there is no constant
# fallback, which would be equivalent to plaintext in a public repo).
# Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# BROKER_TOKEN_ENCRYPTION_KEY=
# Signs the OAuth `state` blob. Unset => a random per-process key is generated, which is safe
# but breaks in-flight links across restarts and across multiple workers. Set it in prod.
# ROBINHOOD_OAUTH_STATE_SECRET=another_long_random_secret
# Set true only when you intend real orders (internal testing).
ROBINHOOD_EXECUTE=false
# Per-order notional ceiling, enforced on BOTH buys and sells. Read on every order, so it can
# be tightened without a restart. An unparseable or non-positive value falls back to 25.
ROBINHOOD_MAX_ORDER_USD=25

# Daily Leaderboard — rolling one-day competition board (?period=daily).
# LEADERBOARD_DAILY_REFRESH_SECRET=generate_a_long_random_secret_here
# Nightly cron (GitHub Actions or refresh_daily_leaderboard.py --remote) POSTs to
# /api/v1/leaderboard/daily/refresh with header X-Leaderboard-Refresh-Secret.
# Unset, that endpoint answers 401 to everyone (it never reveals that it is
# unconfigured) — so the nightly job is simply inert until you set it.
#
# LEADERBOARD_DAILY_AUTO_DEPLOY: strict opt-in, and it costs money. With it on,
# serving the *public* GET /api/v1/leaderboard?period=daily may start a
# background thread that runs every competition LLM model for the window — real
# billable API calls, triggered by an anonymous request. Only turn it on for
# local dev where you want missing curves backfilled on demand; prod (Render)
# uses the nightly refresh job instead. Leave unset everywhere else.
# LEADERBOARD_DAILY_AUTO_DEPLOY=true

# First-admin bootstrap (optional). POST /api/admin/bootstrap with this shared
# secret promotes the signed-in caller to admin, but only while zero admin
# accounts exist. After that it 403s; break-glass is SQL.
#
# MUST BE AT LEAST 32 CHARACTERS. A shorter value is refused as if unset (403
# to the caller, a loud line in the server log) -- this secret grants admin
# with no account behind it and no lockout to hide behind, so its strength is
# the only thing bounding a guesser.
#
# Unset OR too weak answers exactly like a wrong secret (403), so a caller
# cannot learn whether this deployment is bootstrappable; the operator's signal
# goes to the log. Failed guesses are rate-limited per user, per client IP
# (5 / 15 min each) and server-wide (20 / 15 min) -- the server-wide budget is
# checked AFTER the compare, so wrong guesses can never lock the real operator
# out of the fresh-deploy window this route exists for.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# ADMIN_BOOTSTRAP_SECRET=generate_a_long_random_secret_here

# Concurrent backtests a NEW account gets before an admin edits its row
# (0..20). Nothing seeds user_entitlements at signup and nothing backfills, so
# this is also the live limit for every account that already exists -- lowering
# it throttles all of them at once, with no way back that does not need an
# admin. Default 5, matching MAX_ACTIVE_RUNS_PER_AGENT so a one-agent account
# is unchanged. Out-of-range/unparseable falls back to 5 with a log line.
# DEFAULT_MAX_CONCURRENT_BACKTESTS=5

# Credit metering: bill one credit per LLM-driven dashboard backtest
# (POST /backtest/run with decision_source=llm -- the only path where the
# operator's own key pays for the model). STRICT OPT-IN: off unless set to
# 1/true/yes/on. Arming it also makes that route sign-in-only, since a
# signed-out session has no balance to spend. Rule-based runs and the agent
# protocol surfaces (/api/v1/runs, /api/v2/runs -- the agent brings its own
# LLM) are never charged. A run is refunded if it made no LLM call at all.
# CREDITS_METERING_ENABLED=1

# Credits a NEW account holds before an admin edits its row (0..1000000).
# Same backfill caveat as DEFAULT_MAX_CONCURRENT_BACKTESTS above: nothing seeds
# user_entitlements, so this is every existing account's balance the moment
# metering is armed -- which is why it is not 0. Default 100.
# DEFAULT_CREDITS=100

# Database
DATABASE_PATH=dashboard/storage/data/backtest.db

# Shared market-data cache: max distinct (symbols, start, end) datasets held
# in memory for reuse across backtest runs (LRU beyond this). Default 4.
# MARKET_DATA_CACHE_MAX_ENTRIES=4

# Bound every Alpaca market-data HTTP request. alpaca-py issues requests with no
# timeout, so one stalled socket leaks a threadpool thread for the life of the
# process. Connect/read seconds. Defaults 10 / 60.
# ALPACA_HTTP_CONNECT_TIMEOUT_SECONDS=10
# ALPACA_HTTP_TIMEOUT_SECONDS=60

# Max queued background baseline-generation jobs (drops beyond this; the run
# itself is unaffected). Default 500.
# BASELINE_QUEUE_MAX=500

# Global backstop: max active (non-terminal) runs across ALL agents; creates
# beyond this 429 with Retry-After. 0 disables. Default 100 -- the tested
# number; raise only after a measured smoke run at the higher value.
# MAX_ACTIVE_RUNS_GLOBAL=100

# Budgets for the LEGACY /api/v1/backtest/* surface, which authenticates
# nothing (any non-empty X-Session-Id reaches it) and writes no protocol_runs
# row -- so none of the caps above can see its runs. Per-session bounds one
# looping client; the global one is the memory bound that holds regardless,
# since every live session pins a loaded bar window. 0 disables either.
# MAX_LEGACY_ACTIVE_PER_SESSION=5
# MAX_LEGACY_ACTIVE_GLOBAL=50

# How long a terminal legacy /api/v1/backtest/* session is kept in memory before
# the reaper sweep drops it. Once evicted, {backtest_id}-keyed reads (status,
# decisions, steps/current) 404 -- there is no DB fallback for those. Only the
# run's result/trades/decisions stay readable, via the DB-backed
# GET /api/v1/backtest/runs/{run_id}/result (and /trades, /decisions). This
# only buys an in-flight {backtest_id} reader some slack. Seconds. Default 300.
# LEGACY_SESSION_RETENTION_SECONDS=300

# Auth cache TTL for agent API keys (seconds; +-20% jitter; 0 disables).
# Rotation/deletion invalidates immediately; other agent-record edits
# propagate within the TTL. Default 10.
# AGENT_AUTH_CACHE_TTL_SECONDS=10

# User accounts (optional). When set, signup/login/session data is stored in
# this Postgres database instead of the local SQLite file above -- required
# on hosts with an ephemeral/disk-less filesystem (e.g. Render free tier),
# where DATABASE_PATH resets on every deploy and would otherwise silently
# delete every account. Use a pooled connection string if your provider
# offers one (e.g. Neon's "-pooler" host) since each store call opens a new
# connection. Leave unset for local dev -- falls back to DATABASE_PATH.
# USERS_DATABASE_URL=postgresql://user:password@host/dbname

# Browser origins allowed to call the API cross-origin (comma-separated).
# Same-origin Vercel traffic uses vercel.json rewrites and does not need this.
# When unset, CORS stays `*` with credentials disabled. When set, CORS enables
# allow_credentials so HttpOnly session cookies work cross-origin. Never enable
# allow_credentials with `*`.
# ATL_FRONTEND_ORIGINS=https://your-frontend.vercel.app

# Session token hashing + lifetimes (account auth). SESSION_HASH_SECRET is the
# HMAC key for auth_sessions.token_hash. It is REQUIRED whenever RENDER is set
# or ATL_ENV=production: the app refuses to start without it, rather than
# quietly keying every session digest on the development fallback. Local/dev
# may omit it and gets that fallback with a warning on stdout.
#   * Upgrading wipes legacy plaintext sessions — users must sign in again.
#   * Rotating this value has the same effect: every live session stops
#     resolving, because the stored digests were computed under the old key.
# SESSION_HASH_SECRET=replace-with-a-long-random-string
# SESSION_TTL_DAYS=7            # absolute cap; a session dies this long after login
# SESSION_IDLE_HOURS=24         # signed out after this long without a request
# SESSION_LAST_SEEN_THROTTLE_SECONDS=600  # how often the idle clock is refreshed

# Session cookie Secure flag. Defaults on when RENDER=1 or ATL_ENV=production
# (uses __Host-atl_session). Local HTTP uses atl_session without Secure.
# ATL_COOKIE_SECURE=true

# Cookie CSRF for browser session cookies (double-submit + Origin allowlist).
# Default on. Set ATL_CSRF=0 only for hermetic TestClient suites that do not
# send X-CSRF-Token. Agent X-API-Key traffic is never gated by CSRF.
# ATL_CSRF=1

# Stripe Credits (Test Mode only). Keep disabled unless all three values below
# are configured. Live Mode keys are deliberately rejected by the application.
#
# DURABILITY: the purchase ledger lives in the *accounts* database and is
# selected by USERS_DATABASE_URL, not by a variable of its own. Leave that unset
# and purchase records land on SQLite, which the free-tier Render service resets
# on every redeploy. Confirm the boot line reads
#   credits_store backend: postgres (<host>/<db>)
# before enabling billing anywhere real.
# ATL_STRIPE_TEST_BILLING_ENABLED=0
# STRIPE_SECRET_KEY=sk_test_replace_with_your_test_key
# STRIPE_WEBHOOK_SECRET=whsec_replace_with_your_test_endpoint_secret
# Uses the existing PUBLIC_APP_URL setting above for Checkout return URLs.

# User-created content (optional). When set, agents, agent versions, and
# strategies are stored in this Postgres database instead of the local SQLite
# file above -- required on ephemeral hosts (Render free tier) where
# DATABASE_PATH resets on every deploy, deleting every registered agent and
# invalidating every issued agent API key. Covers content only: accounts are
# selected separately by USERS_DATABASE_URL above, and neither var falls back
# to the other -- set BOTH for a fully durable deployment, pointed at the SAME
# database so user->agent ownership stays joinable. Deliberately not named
# DATABASE_URL: that name is the Heroku convention a managed-Postgres add-on
# injects on its own, and an inherited value would silently bind this app to
# someone else's database. Use a pooled connection string (e.g. Neon's
# "-pooler" host) since each store call opens a new connection. Leave unset for
# local dev.
# CONTENT_DATABASE_URL=postgresql://user:password@host/dbname

# Run history (optional). When set, backtest run history -- runs, equity
# curves, trades, decisions, and run manifests -- is stored in this Postgres
# database instead of the local SQLite file above -- required on ephemeral
# hosts (Render free tier) where DATABASE_PATH resets on every deploy,
# silently deleting every completed run. Covers run history only: it does not
# fall back to or from CONTENT_DATABASE_URL (agents/versions/strategies) or
# USERS_DATABASE_URL (accounts), and neither of those falls back to this one --
# set ALL THREE for a fully durable deployment. Deliberately not named
# DATABASE_URL: that name is the Heroku convention a managed-Postgres add-on
# injects on its own, and an inherited value would silently bind this app to
# someone else's database. Use a pooled connection string (e.g. Neon's
# "-pooler" host) since each store call opens a new connection. Leave unset for
# local dev.
# AGENT_RUNS_DATABASE_URL=postgresql://user:password@host/dbname

# Transactional email (Brevo) -- powers the account email-change flow
# (dashboard/backend/infrastructure/email/sender.py). BREVO_API_KEY and
# ACCOUNT_EMAIL_FROM are BOTH required for mail to send; ACCOUNT_EMAIL_FROM_NAME
# is optional and defaults to "Agentic Trading Lab". Leave either required key
# unset and the two steps that SEND mail return 503: POST /api/auth/email-change
# (code to the current address) and the verify call that advances stage old->new
# (code to the new address). The final verify -- the one that commits the change
# -- sends nothing and succeeds regardless, so a mid-flight credential rotation
# does not strand a user who already holds the second code. Display-name editing
# and logout keep working either way.
BREVO_API_KEY=your_brevo_api_key_here
ACCOUNT_EMAIL_FROM=noreply@example.com
ACCOUNT_EMAIL_FROM_NAME=Agentic Trading Lab

# Auth rate limits (optional). Best-effort in-process budgets for
# POST /api/auth/login and /signup; defaults shown, and each is echoed at
# startup as "auth rate limit AUTH_...: N per Ns" so the effective value is
# readable in the deploy log. Set any *_MAX to 0 to disable that budget.
#
# Both login budgets meter *failed* attempts only, so a correct password is
# never refused because of someone else's guesses. The per-IP budgets are loose
# on purpose: they are keyed on caller-supplied headers (X-Browser-Id, then
# X-Forwarded-For), so they bound naive abuse rather than a real attacker, and
# a tight value mostly punishes shared addresses. AUTH_LOGIN_EMAIL_MAX is the
# one that actually bounds password guessing -- keyed on the targeted account.
# AUTH_LOGIN_IP_MAX=60
# AUTH_LOGIN_IP_WINDOW_SECONDS=900
# AUTH_LOGIN_EMAIL_MAX=10
# AUTH_LOGIN_EMAIL_WINDOW_SECONDS=900
# AUTH_SIGNUP_IP_MAX=60
# AUTH_SIGNUP_IP_WINDOW_SECONDS=3600
# AUTH_SIGNUP_EMAIL_MAX=5
# AUTH_SIGNUP_EMAIL_WINDOW_SECONDS=3600

# API Configuration
PORT=8000
DEBUG=false
PYTHONUNBUFFERED=true
